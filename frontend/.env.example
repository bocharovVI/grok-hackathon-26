# Public API origin, inlined at `npm run build` (Vite).
# On Render this must be HTTPS. Private *.onrender.com hostnames will not work
# from a static site. After changing this, rebuild / redeploy.
VITE_API_URL=http://localhost:8000
# Explicit demo mode only; never use for real medical documents or passwords.
VITE_USE_MOCK=false
